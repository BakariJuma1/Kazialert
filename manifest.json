{
  "manifest_version": 3,
  "name": "Kazi Alert",
  "version": "1.0.0",
  "description": "AI-powered job matching — monitors job boards and career pages, emails you only the jobs you actually fit.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kazi Alert",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content-scripts/linkedin-reader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.linkedin.com/*"],
      "js": ["content-scripts/job-extractor.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "homepage_url": "https://github.com/BakariJuma1/Kazialert",
  "permissions": ["storage", "alarms", "scripting", "tabs", "notifications", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
